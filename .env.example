# --- Claude (Anthropic) ---
# Crie em https://platform.claude.com/ -> API Keys
ANTHROPIC_API_KEY=

# --- Instagram (API do Instagram com login do Instagram) ---
# Conta precisa ser Profissional (Empresa ou Criador de conteúdo).
# Token de longa duração com permissões instagram_business_basic,
# instagram_business_content_publish e instagram_business_manage_insights.
INSTAGRAM_ACCESS_TOKEN=
# Opcional: ID da conta. Se vazio, o agente descobre sozinho via /me.
INSTAGRAM_USER_ID=
# Base da API (padrão: Instagram Login). Para contas ligadas a Página do
# Facebook use https://graph.facebook.com/v21.0
INSTAGRAM_API_BASE=https://graph.instagram.com/v21.0

# --- Hospedagem das artes ---
# O Instagram só publica imagens a partir de uma URL pública.
# Opção 1 (mais simples): chave gratuita em https://api.imgbb.com/
IMGBB_API_KEY=
# Opção 2: se você já serve a pasta ./saida publicamente, informe a URL base
# (ex.: https://meusite.com/artes). Usado quando IMGBB_API_KEY estiver vazio.
PUBLIC_BASE_URL=

# --- Marca (usado nas artes) ---
MARCA_NOME=Pronto Vendi
MARCA_ARROBA=@prontovendipoa
MARCA_COR_PRIMARIA=#6CD000
MARCA_COR_SECUNDARIA=#0A0A0A
MARCA_COR_TEXTO=#FFFFFF
